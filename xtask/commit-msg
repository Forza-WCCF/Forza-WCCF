#!/bin/bash
# commit-msg: refuse a message that names the publisher (built from bytes, so this file does not spell it), matches a line of
# ~/.config/forza-wccf/scrub.txt (personal data; one case-insensitive extended regex per line, # starts a comment), or
# carries a Co-Authored-By trailer for an AI. Install: ln -sf ../../xtask/commit-msg "$(git rev-parse --git-common-dir)/hooks/commit-msg"
# CI runs it over every commit message of a pull request.
msg=$(grep -v '^#' "$1")
p=$(printf '\x73\x65\x67\x61')
k=$(printf '\xe3\x82\xbb\xe3\x82\xac')
if printf '%s' "$msg" | grep -qiE "$p|$k"; then
    echo "commit-msg: the message names the publisher - say 'the publisher' or 'original'" >&2; exit 1
fi
if printf '%s' "$msg" | grep -qiE '^co-authored-by:.*(claude|anthropic|openai|codex|copilot|gpt)|noreply@anthropic\.com'; then
    echo "commit-msg: no Co-Authored-By trailer for an AI" >&2; exit 1
fi
f="$HOME/.config/forza-wccf/scrub.txt"
if [ -f "$f" ] && printf '%s' "$msg" | grep -qiEf <(grep -v '^#' "$f" | grep .) 2>/dev/null; then
    echo "commit-msg: the message matches a pattern in $f (personal data)" >&2; exit 1
fi
exit 0
