# not in the kit ZIP (cargo xtask package copies the working tree by its own table, so this only keeps git archive tidy): the repository's own files
.gitattributes export-ignore
.gitignore export-ignore
# research notes for the people working on the kit, not for players
docs export-ignore
# the other sources being moved into place (ROADMAP step 3): not in the 2010-11 ZIP
import export-ignore
# the other editions and tools (ROADMAP step 3 layout): not in the 2010-11 ZIP
crates export-ignore
research export-ignore
# the Rust workspace's root files: the 2010-11 ZIP carries the launcher sources (xtask maps them to source\launcher\) but not the workspace
/Cargo.toml export-ignore
/Cargo.lock export-ignore
/rust-toolchain.toml export-ignore
/.cargo export-ignore
